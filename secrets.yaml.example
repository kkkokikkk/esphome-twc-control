# Copy this to secrets.yaml (it's in .gitignore, never pushed) and fill in real values.
wifi_ssid: "YourWifi"
wifi_password: "YourPassword"
ap_password: "FallbackAPPassword"
# Generate with: python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
api_encryption_key: "GENERATE_A_32B_BASE64_KEY=="
ota_password: "set_a_strong_password"

# TWO different breakers, do not mix them up! See README for how to find
# the right values for your installation.
# TWC's own sub-circuit breaker / internal Home Load Management limit, set
# in the Tesla installer menu for TWC3 -- must match exactly.
twc_breaker_limit_a: "16.0"
# Main incomer breaker, measured by the Shelly Pro 3EM on the main feed.
# Can be higher than twc_breaker_limit_a -- the car is limited by whichever
# of the two is lower.
main_breaker_limit_a: "25.0"

# HA entity IDs for real per-phase current/power (from your Shelly Pro 3EM
# integration in HA -- Settings -> Devices & Services -> Shelly -> the
# device's entities, or Developer Tools -> States to find the exact IDs).
# Replace with your own entity IDs, e.g. sensor.shelly_3em_phase_a_current.
#
# JP fork -- on a Japanese 単相3線式 (split-phase) supply, set
# phase_count: "2" and grid_voltage_v: "100" in twc-control.yaml, then map
# phase A = L1 and phase B = L2. `worst = max(signed_a, signed_b, ...)`
# then means "the worst leg", which is what the main breaker actually
# trips on. Phase C is unused: ESPHome substitutions are compile-time so
# the C blocks cannot be dropped, but nothing reads them -- point C at the
# same entity as A so it stays "available" without warning spam.
#
# IMPORTANT -- current must be UNSIGNED, power carries the sign. If your
# meter reports signed per-leg current, build four HA template sensors:
#   Grid current L1/L2 = abs(<leg current>)          unit A
#   Grid power   L1/L2 = <leg current> * 100         unit W  (sign only)
# Passing signed current straight in flips the sign (see twc-control.yaml).
# Use the nominal 100, not a slow-polled voltage entity -- only the sign is
# read, and there is no reason to couple the fast path to a slow one.
ha_current_a_entity: "sensor.your_shelly_phase_a_current"
ha_current_b_entity: "sensor.your_shelly_phase_b_current"
ha_current_c_entity: "sensor.your_shelly_phase_c_current"
ha_power_a_entity: "sensor.your_shelly_phase_a_active_power"
ha_power_b_entity: "sensor.your_shelly_phase_b_active_power"
ha_power_c_entity: "sensor.your_shelly_phase_c_active_power"
# The input_boolean helper toggle you create in HA (see README) -- change
# only if you name it something other than input_boolean.charge_from_grid.
ha_charge_from_grid_entity: "input_boolean.charge_from_grid"

# TWC3's own local LAN IP (not HA) -- used to poll its /api/1/vitals
# endpoint directly for ground-truth diagnostics (currentA/B/C_a,
# vehicle_current_a, contactor_closed), independent of Shelly/HA. Find it
# in your router's DHCP client list (device usually named "TWCxxxxxxxx").
twc_vitals_ip: "192.168.1.101"
